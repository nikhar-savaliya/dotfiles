theme = light:maxx-mellow-dawn,dark:maxx-mellow
# font-family = GeistMono Nerd Font
# font-family = TX-02
# font-family = DankMono Nerd Font
font-family = SF Mono Terminal
# font-family = Menlo
# font-family = Osaka
# font-family = FiraCode Nerd Font
# font-family = Iosevka Berkeley Mono
# font-family = UbuntuMono Nerd Font Mono

window-save-state = always

font-size = 11
# font-thicken = false
adjust-cell-height = 20%
font-feature = liga=0, calt=0

# window-colorspace = display-p3

# window-padding-x = 4
# window-padding-y = 4
# window-padding-balance = false

maximize = false

# macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden

cursor-style = block
cursor-style-blink = true

shell-integration-features = no-cursor

mouse-hide-while-typing = true

keybind = shift+enter=text:\n

macos-option-as-alt = true
# macos-icon = blueprint

# window-padding-color = extend

# Better link handling
link-url = true

# App behavior
app-notifications = no-clipboard-copy

macos-icon = custom
macos-custom-icon = ~/.config/ghostty/ghostty-pink.icns
