[
  // {
  //   "key": "shift+;",
  //   "command": "vim.showQuickpickCmdLine",
  //   "when": "editorTextFocus && vim.mode != 'Insert'"
  // },

  {
    "key": "space s s",
    "command": "editor.action.surroundWithSnippet",
    "when": "editorTextFocus && !editorReadonly && (vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine' || vim.mode == 'VisualBlock')",
  },
  {
    "key": "space g g",
    "command": "git-graph.view",
    "when": "editorTextFocus && !editorReadonly && (vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualLine' || vim.mode == 'VisualBlock')",
  },
  /*
    ---------------------------------------
    WINDOW / GROUP NAVIGATION
    ---------------------------------------
    */
  {
    "key": "ctrl-h",
    "command": "workbench.action.navigateLeft",
  },
  {
    "key": "ctrl-l",
    "command": "workbench.action.navigateRight",
  },
  {
    "key": "ctrl-k",
    "command": "workbench.action.navigateUp",
  },
  {
    "key": "ctrl-j",
    "command": "workbench.action.navigateDown",
  },

  /*
    ---------------------------------------
    BUFFER / TAB MANAGEMENT
    ---------------------------------------
    */
  {
    "key": "tab",
    "command": "workbench.action.nextEditorInGroup",
    "when": "(vim.mode == 'Normal' || vim.mode == 'Visual') && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "shift-tab",
    "command": "workbench.action.previousEditorInGroup",
    "when": "(vim.mode == 'Normal' || vim.mode == 'Visual') && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space b d",
    "command": "workbench.action.closeActiveEditor",
    "when": "vim.mode == 'Normal' && !vim.operatorPending && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space b o",
    "command": "workbench.action.closeOtherEditors",
    "when": "vim.mode == 'Normal' && !vim.operatorPending && (editorTextFocus || !inputFocus)",
  },

  /*
    ---------------------------------------
    EXPLORER / FILE MANAGEMENT
    ---------------------------------------
    */
  {
    "key": "space e",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus) && filesExplorerFocus",
  },
  {
    "key": "space e",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus) && !filesExplorerFocus",
  },
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "c",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "shift-a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "s",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "shift-s",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.splitEditorDown",
        "explorer.openAndPassFocus",
        "workbench.action.closeOtherEditors",
      ],
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "enter",
    "command": "-renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },

  /*
    ---------------------------------------
    EDITOR ACTIONS
    ---------------------------------------
    */
  {
    "key": "shift-k",
    "command": "editor.action.showHover",
    "when": "vim.mode == 'Normal' && editorTextFocus",
  },
  {
    "key": "ctrl+m",
    "command": "editor.toggleFold",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl-n",
    "command": "editor.action.addSelectionToNextFindMatch",
    "when": "(vim.mode == 'Normal' || vim.mode == 'Visual') && (editorTextFocus || !inputFocus)",
  },

  /*
    ---------------------------------------
    CODE NAVIGATION / ACTIONS
    ---------------------------------------
    */
  {
    "key": "space c a",
    "command": "editor.action.codeAction",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space c n",
    "command": "editor.action.rename",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space c s",
    "command": "workbench.action.gotoSymbol",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space g d",
    "command": "editor.action.revealDefinition",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space g r",
    "command": "editor.action.goToReferences",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },

  /*
    ---------------------------------------
    SEARCH & QUICK OPEN
    ---------------------------------------
    */
  {
    "key": "space r",
    "command": "workbench.action.showAllEditorsByMostRecentlyUsed",
    "when": "vim.mode == 'Normal' &&  (editorTextFocus || !inputFocus)",
  },
  {
    "key": "space space",
    "command": "workbench.action.quickOpen",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
  },
  {
    "key": "shift shift",
    "command": "workbench.action.quickTextSearch",
    "when": "(vim.mode == 'Normal' || vim.mode == 'Visual') && (editorTextFocus || !inputFocus)",
  },

  /*
    ---------------------------------------
    QUICK OPEN NAVIGATION (CMD+P)
    ---------------------------------------
    */
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen",
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen",
  },

  /*
    ---------------------------------------
    CODE ACTION LIST NAVIGATION (CMD+.)
    ---------------------------------------
    */

  {
    "key": "ctrl+j",
    "command": "selectNextCodeAction",
    "when": "codeActionMenuVisible",
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevCodeAction",
    "when": "codeActionMenuVisible",
  },

  /*
    ---------------------------------------
    EDITOR SUGGESTION WIDGET NAVIGATION
    ---------------------------------------
    */

  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible && textInputFocus",
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible && textInputFocus",
  },

  /*
    ---------------------------------------
    FONT ZOOM (EDITOR / TERMINAL)
    ---------------------------------------
    */
  {
    "key": "alt+cmd+=",
    "command": "editor.action.fontZoomIn",
    "when": "editorFocus",
  },
  {
    "key": "alt+cmd+=",
    "command": "workbench.action.terminal.fontZoomIn",
    "when": "terminalFocus",
  },
  {
    "key": "alt+cmd+-",
    "command": "editor.action.fontZoomOut",
    "when": "editorFocus",
  },
  {
    "key": "alt+cmd+-",
    "command": "workbench.action.terminal.fontZoomOut",
    "when": "terminalFocus",
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\\\r\n",
    },
    "when": "terminalFocus",
  },
  {
    "key": "shift+cmd+k",
    "command": "-editor.action.deleteLines",
    "when": "textInputFocus && !editorReadonly",
  },
  {
    "key": "shift+cmd+k",
    "command": "claude-vscode.sidebar.open",
  },

  /*
    ---------------------------------------
    TERMINAL NAVIGATION
    ---------------------------------------
    */
  {
    "key": "ctrl+j",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+shift+n",
    "command": "workbench.action.terminal.new",
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+shift+w",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+shift+c ctrl+shift+n",
    "command": "workbench.action.terminal.rename",
    "when": "terminalHasBeenCreated || terminalProcessSupported",
  },
  {
    "key": "ctrl+shift+c ctrl+shift+i",
    "command": "workbench.action.terminal.changeIcon",
    "when": "terminalHasBeenCreated || terminalProcessSupported",
  },
  {
    "key": "cmd+l",
    "command": "-expandLineSelection",
    "when": "textInputFocus",
  },
  {
    "key": "cmd+l",
    "command": "-workbench.action.browser.focusUrlInput",
    "when": "activeEditor == 'workbench.editor.browser'",
  },
  {
    "key": "cmd+l",
    "command": "markdown.extension.checkTaskList",
    "when": "editorLangId =~ /^markdown$|^rmd$|^quarto$/",
  },
  {
    "key": "shift+cmd+g",
    "command": "-editor.action.previousMatchFindAction",
    "when": "editorFocus",
  },
  {
    "key": "shift+cmd+g",
    "command": "-workbench.action.terminal.findPrevious",
    "when": "terminalFindFocused && terminalHasBeenCreated || terminalFindFocused && terminalProcessSupported || terminalFocusInAny && terminalHasBeenCreated || terminalFocusInAny && terminalProcessSupported",
  },
  {
    "key": "shift+cmd+g",
    "command": "-workbench.action.terminal.openDetectedLink",
    "when": "accessibleViewIsShown && terminalHasBeenCreated && accessibleViewCurrentProviderId == 'terminal'",
  },
  {
    "key": "shift+cmd+g",
    "command": "-notebook.findPrevious.fromWidget",
    "when": "findWidgetVisible && notebookEditorFocused",
  },
  {
    "key": "shift+cmd+g",
    "command": "-workbench.action.browser.findPrevious",
    "when": "browserFindWidgetVisible && activeEditor == 'workbench.editor.browser'",
  },
  {
    "key": "shift+cmd+g",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active",
  },
  {
    "key": "ctrl+shift+g",
    "command": "-workbench.view.scm",
    "when": "workbench.scm.active",
  },
]
