{
  // --- Editor Core (Formatting & Behavior) ---
  "workbench.editor.useModal": "off",
  "workbench.browser.showInTitleBar": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "symbols.hidesExplorerArrows": true,
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.lineNumbers": "relative",
  "editor.cursorBlinking": "solid",
  "editor.cursorSurroundingLines": 10,
  "editor.stickyScroll.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.occurrencesHighlight": "off",
  "editor.fontFamily": "JetBrains Mono NL",
  "editor.lineHeight": 1.5,
  "files.trimTrailingWhitespace": true,
  "diffEditor.ignoreTrimWhitespace": false,
  // "editor.letterSpacing": 0.3,
  "editor.fontLigatures": false,
  "editor.fontVariations": false,
  "editor.glyphMargin": true,
  "editor.padding.top": 0,
  "editor.minimap.enabled": false,
  "workbench.panel.opensMaximized": "always",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "window.commandCenter": false,
  "explorer.compactFolders": false,
  "explorer.confirmPasteNative": false,
  "explorer.decorations.badges": false,
  "explorer.decorations.colors": false,
  "workbench.editor.decorations.badges": false,
  "workbench.editor.decorations.colors": false,
  "terminal.integrated.suggest.enabled": false,
  // --- Git & SCM ---
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "scm.diffDecorations": "gutter",
  // --- Vim Configuration ---
  "vim.leader": "<space>",
  "vim.easymotion": true,
  "vim.foldfix": true,
  "vim.useCtrlKeys": true,
  "vim.textwidth": 200,
  "vim.showcmd": false,
  "vim.useSystemClipboard": true,
  "vim.overrideCopy": false,
  "vim.changeWordIncludesWhitespace": true,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-p>": false,
    "<C-y>": false,
  },
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"],
    },
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": ["<C-n>"],
      "commands": [":nohl"],
    },
    {
      "before": ["K"],
      "commands": ["lineBreakInsert"],
      "silent": true,
    },
    {
      "before": ["<C-d>"],
      "after": ["<C-d>", "z", "z"],
    },
    {
      "before": ["<C-u>"],
      "after": ["<C-u>", "z", "z"],
    },
    {
      "before": ["n"],
      "after": ["n", "z", "z"],
    },
    {
      "before": ["N"],
      "after": ["N", "z", "z"],
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.next"],
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prev"],
    },
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"],
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"],
    },
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"],
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"],
    },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["p"],
      "after": ["p", "g", "v", "y"],
    },
  ],
  // --- Language Specifics ---
  "css.lint.unknownAtRules": "ignore",
  // --- Extension Miscellaneous ---
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "security.workspace.trust.untrustedFiles": "open",
  "breadcrumbs.icons": false,
  "window.title": "${rootName}${separator}",
  "chat.agent.enabled": true,
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },
  "githubPullRequests.createOnPublishBranch": "never",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "workbench.colorCustomizations": {
    "[JetBrains New UI Dark Theme]": {
      "editorCursor.foreground": "#eeeeee",
    },
  },
  "go.toolsManagement.autoUpdate": true,
  "workbench.productIconTheme": "jetbrains-product-icons",
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.stickyScroll.enabled": false,
  "chat.disableAIFeatures": true,
  "workbench.experimental.modernUI": false,
  "workbench.activityBar.location": "bottom",
  "workbench.colorTheme": "Cursor Dark",
}
