{
  "window.restoreWindows": "none",
  "editor.indentSize": "tabSize",
  "editor.tabSize": 2,
  "workbench.panel.opensMaximized": "always",
  "window.confirmBeforeClose": "always",
  "editor.fontFamily": "OperatorMonoLig Nerd Font Mono",
  "editor.fontSize": 16,
  "editor.lineHeight": 1.75,
  "editor.letterSpacing": 0.5,
  "files.trimTrailingWhitespace": true,
  "editor.fontWeight": "normal",
  "editor.cursorBlinking": "phase",
  "terminal.integrated.fontWeightBold": "500",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.letterSpacing": 2.1,
  "editor.lineNumbers": "relative",
  "editor.wordWrap": "on",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.occurrencesHighlight": "off",
  "editor.renderWhitespace": "none",
  "scm.diffDecorations": "gutter",
  "editor.stickyScroll.enabled": false,
  "editor.cursorSurroundingLines": 10,
  "explorer.compactFolders": false,
  "explorer.confirmPasteNative": false,

  "workbench.colorCustomizations": {
    "[Serendipity Sunset]": {
      "editorCursor.foreground": "#D7B4B4",
      "editorCursor.background": "#202231",
    },
  },

  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.minimap.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "git.autofetch": true,
  "css.lint.unknownAtRules": "ignore",
  "catppuccin-noctis-icons.hidesExplorerArrows": true,
  "workbench.preferredLightColorTheme": "Kashi Morning",
  "workbench.preferredDarkColorTheme": "Kashi Night",
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
  },
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx",
  },
  "color-highlight.markRuler": false,
  "cSpell.useCustomDecorations": true,
  "cSpell.showInRuler": false,

  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "editor.fontLigatures": true,
  "editor.fontVariations": true,
  "editor.glyphMargin": true,
  "editor.padding.top": 0,

  "vim.easymotion": true,
  "vim.leader": "<space>",
  "vim.foldfix": true,
  "vim.useCtrlKeys": true,
  "vim.textwidth": 200,
  "vim.showcmd": false,
  "vim.useSystemClipboard": true,
  "vim.overrideCopy": false,
  "vim.changeWordIncludesWhitespace": true,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-p>": false,
    "<C-y>": false,
  },
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"],
    },
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": ["<C-n>"],
      "commands": [":nohl"],
    },
    {
      "before": ["K"],
      "commands": ["lineBreakInsert"],
      "silent": true,
    },
    {
      "before": ["<C-d>"],
      "after": ["<C-d>", "z", "z"],
    },
    {
      "before": ["<C-u>"],
      "after": ["<C-u>", "z", "z"],
    },
    {
      "before": ["n"],
      "after": ["n", "z", "z"],
    },
    {
      "before": ["N"],
      "after": ["N", "z", "z"],
    },
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"],
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"],
    },
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"],
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"],
    },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["p"],
      "after": ["p", "g", "v", "y"],
    },
  ],
  "workbench.editor.showIcons": false,
  "workbench.editor.decorations.badges": false,
  "workbench.editor.decorations.colors": false,
  "claudeCode.preferredLocation": "sidebar",
  "terminal.integrated.suggest.enabled": false,
  // "workbench.editor.tabActionCloseVisibility": false,
  // "workbench.editor.tabActionLocation": "left",

  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "window.commandCenter": false,
  "window.title": "${rootPath}",
  "security.workspace.trust.untrustedFiles": "open",
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.mcp.gallery.enabled": true,
  "chat.extensionUnification.enabled": false,
  "workbench.productIconTheme": "Tabler",
  "chat.viewSessions.enabled": false,
  "claudeCode.selectedModel": "sonnet",
  "workbench.colorTheme": "Serendipity Sunset",
  "workbench.iconTheme": "symbols",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
}
